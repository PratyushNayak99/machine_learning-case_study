{
  "dataset_name": "metropt_3_air_compressor_dataset",
  "source_url": "https://archive.ics.uci.edu/dataset/791/metropt+3",
  "student_owner": "student_4",
  "domain": "Urban Metro Train Air Production Unit (Compressor APU)",
  "sampling_rate": "1 Hz",
  "target_column": "failure_event",
  "target_type": "binary_event_detection",
  "target_classes": {
    "0": "Nominal Operation (Outside failure buffer)",
    "1": "Active Failure Event Window"
  },
  "sensors": [
    "TP2",
    "TP3",
    "H1",
    "DV_pressure",
    "Reservoirs",
    "Motor_current",
    "Oil_level"
  ],
  "documented_failure_events": [
    {
      "id": "event_1",
      "description": "Air leakage failure in compressor pneumatic circuit",
      "start": "2020-04-18 00:00:00",
      "end": "2020-04-18 23:59:59"
    },
    {
      "id": "event_2",
      "description": "Major air intake valve leakage causing pressure drop",
      "start": "2020-05-29 23:30:00",
      "end": "2020-05-30 06:00:00"
    },
    {
      "id": "event_3",
      "description": "Pressure regulation failure and oil leak",
      "start": "2020-06-05 10:00:00",
      "end": "2020-06-07 14:30:00"
    },
    {
      "id": "event_4",
      "description": "Secondary compressor circuit breakdown",
      "start": "2020-07-15 14:00:00",
      "end": "2020-07-15 19:00:00"
    }
  ],
  "window_protocol": {
    "window_size_seconds": 300,
    "step_size_seconds": 300,
    "exclusion_buffer_hours": 6
  }
}
